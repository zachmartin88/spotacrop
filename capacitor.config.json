{
  "appId": "com.zmrtn.spotacrop",
  "appName": "Spot-a-Crop",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0d0f12",
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#0d0f12",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    },
    "LocalNotifications": {
      "iconColor": "#e8c170"
    }
  }
}
